{
  "name": "server-buddies",
  "version": "0.1.3",
  "description": "Cute, interactive characters that hang from your website. Pick a character, a tether and its behaviours — drop it into any site, or use the React component.",
  "keywords": [
    "mascot",
    "character",
    "buddy",
    "server",
    "status-page",
    "animation",
    "svg",
    "widget",
    "react",
    "web-component",
    "easter-egg"
  ],
  "license": "MIT",
  "author": "mahmed74",
  "homepage": "https://mahmed74.github.io/server-buddies/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmed74/server-buddies.git"
  },
  "bugs": {
    "url": "https://github.com/mahmed74/server-buddies/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/server-buddies.global.js",
  "jsdelivr": "./dist/server-buddies.global.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs": "npm run build && node scripts/serve.mjs",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
